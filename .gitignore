# Widget Preview related
.widget_preview/

# Vendored Flutter SDK checkout used only for local tooling — not part
# of the app, and far too large to publish (~1.5GB).
tools/flutter/

# Stale, unused `flutter create` scaffold left over from project setup.
.flutter_scaffold/

# Claude Code session tooling — not part of the app.
.claude/

# Cloud Functions
functions/node_modules/
functions/lib/

# Firebase config: regenerate locally with `flutterfire configure` —
# not published since it identifies this specific Firebase project.
android/app/google-services.json
lib/firebase_options.dart
ios/Runner/GoogleService-Info.plist
firebase-debug.log
firebase-debug.*.log
.firebase/
