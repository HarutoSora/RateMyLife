rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function publicProfile(uid) {
      return get(/databases/$(database)/documents/profiles/$(uid)).data;
    }

    // A comment/rating target may be a mock/seed profile with no
    // Firestore doc at all — treat that as "allowed" (client-side mock
    // defaults apply) rather than evaluating `get()` on a document that
    // doesn't exist, which denies outright instead of returning "not
    // found" (see the `ratings` rule below for the same gotcha).
    // `.get('allowComments', true)`, not raw `.allowComments` — a
    // profile created before this field existed has no such key at
    // all, and Firestore rules error out (denying the whole request)
    // on a missing-key dot-access rather than falling back to the
    // `ProfilePrivacy.fromJson` default (`?? true`) or an old profile
    // silently blocks comments that the client-rendered privacy
    // toggle claims are allowed.
    function commentsAllowed(profileOwnerId) {
      return !exists(/databases/$(database)/documents/profiles/$(profileOwnerId))
        || (publicProfile(profileOwnerId).privacy.visibility == 'public'
            && publicProfile(profileOwnerId).privacy.get('allowComments', true) == true);
    }

    function hasBlocked(blockerUid, blockedUid) {
      return exists(/databases/$(database)/documents/profiles/$(blockerUid)/blocked/$(blockedUid));
    }

    // Every `LifeScore` category `LifeScoreService._clamp` ever produces
    // is 0-100 — no legitimate write from the real app can ever fall
    // outside this range. Applied to both the owner's own profile writes
    // and a nuke attacker's cross-profile write below, so neither path
    // can plant an out-of-range score (e.g. `overall: 9999`) via a raw
    // write that bypasses the app's own scoring engine entirely.
    function validScoreBounds(score) {
      return score.overall >= 0 && score.overall <= 100
        && score.career >= 0 && score.career <= 100
        && score.financial >= 0 && score.financial <= 100
        && score.education >= 0 && score.education <= 100
        && score.independence >= 0 && score.independence <= 100
        && score.social >= 0 && score.social <= 100
        && score.lifestyle >= 0 && score.lifestyle <= 100
        && score.wellbeing >= 0 && score.wellbeing <= 100;
    }

    // Mirrors `ProgressionService.xpRewards` / `RewardService.
    // coinRewards` exactly — `xpTransactions`/`coinTransactions` below
    // are the ledger `Wallet`/`LevelInfo` are summed from, so without
    // this a signed-in device could write a transaction doc with an
    // arbitrary `amount` directly (bypassing the app's UI and its reward
    // tables entirely) and inflate its own balance/XP without limit.
    // IMPORTANT: if either reward table in Dart changes, this must be
    // updated to match, or the app's own legitimate grants start being
    // rejected — this duplication is a real, disclosed maintenance cost
    // of validating amounts without a Cloud-Function-only write path.
    function validXpAmount(reason, amount) {
      return (reason == 'profileCompleted' && amount == 150)
        || (reason == 'profileUpdated' && amount == 20)
        || (reason == 'photoAdded' && amount == 30)
        || (reason == 'ratingGiven' && amount == 15)
        || (reason == 'profileShared' && amount == 25)
        || (reason == 'battleVoted' && amount == 10)
        || (reason == 'choiceMade' && amount == 15)
        // Variable per-catalog-entry bonuses (`AchievementDefinition.
        // xpReward` / `DailyChallenge.xpReward`) — exact membership in
        // the real catalog's value set, not just an upper bound.
        || (reason == 'achievementUnlocked' && amount in [50, 75, 100, 150, 200, 300, 500, 1000])
        || (reason == 'dailyChallengeCompleted' && amount in [40, 50, 60, 75, 100]);
      // Every other reason (adWatched, cosmeticPurchased, nukeUsed,
      // curePotionUsed, coinsPurchased, boostPurchased) is coins-only or
      // unimplemented — never valid in xpTransactions.
    }

    function validCoinAmount(reason, amount) {
      return (reason == 'profileCompleted' && amount == 20)
        || (reason == 'profileUpdated' && amount == 3)
        || (reason == 'photoAdded' && amount == 5)
        || (reason == 'ratingGiven' && amount == 2)
        || (reason == 'profileShared' && amount == 5)
        || (reason == 'battleVoted' && amount == 1)
        || (reason == 'choiceMade' && amount == 3)
        || (reason == 'adWatched' && amount == 300)
        || (reason == 'dailyChallengeCompleted' && amount in [8, 10, 12, 15, 20])
        // Spends are negative-amount transactions on the same ledger —
        // `CosmeticFrame.cost` (0 for 'none', 150 for every real frame).
        || (reason == 'cosmeticPurchased' && amount in [0, -150])
        // `NukeService.attackCost` / `.curePotionCost` — rules can't
        // reference a Dart constant, so these are spelled out as
        // literals; keep in sync if either ever changes.
        || (reason == 'nukeUsed' && amount == -5000)
        || (reason == 'curePotionUsed' && amount == -1000)
        // `PurchaseConfig.coinsForProduct`'s exact 5 package sizes.
        || (reason == 'coinsPurchased' && amount in [500, 1200, 2500, 6000, 15000]);
      // achievementUnlocked is XP-only by design (never grants coins);
      // boostPurchased is unimplemented — neither is ever valid here.
    }

    // Applied only to the OWNER's own profile writes (the non-owner nuke
    // branch below has its own, tighter, delta-bounded check). Bounds a
    // single write's `coins`/`xp` INCREASE to the largest legitimate
    // single-grant amount that can ever appear in one `saveCurrentProfile`
    // call — `AppController._applyXpTransaction`/`_applyCoinTransaction`
    // each persist exactly one transaction's delta per write, never a
    // batched sum, so this bound never rejects a real grant. It does not
    // stop a modified client from *repeatedly* writing up to that amount
    // (Firestore rules can't rate-limit), but it does close the
    // one-shot "set my balance to 999999999" exploit outright, and
    // `validScoreBounds` above closes the equivalent one-shot score
    // exploit completely (0-100 is an absolute bound, not just a
    // per-write cap).
    function ownerProfileUpdateIsSafe() {
      return (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins'])
              || request.resource.data.coins - resource.data.get('coins', 0) <= 15000)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['xp'])
            || request.resource.data.xp - resource.data.get('xp', 0) <= 1000)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['score'])
            || validScoreBounds(request.resource.data.score));
    }

    // Same "missing profile doc = allowed" reasoning as commentsAllowed.
    // `.get('allowMessages', true)`, not raw `.allowMessages` — a
    // profile created before this field existed has no such key at
    // all, and Firestore rules error out (denying the whole request)
    // on a missing-key dot-access rather than treating it as null.
    // The safe accessor's default must match the client's own
    // `ProfilePrivacy.fromJson` default (`?? true`) or an old profile
    // silently blocks messages that the client-rendered privacy
    // toggle claims are allowed.
    function messagesAllowed(recipientId) {
      return !exists(/databases/$(database)/documents/profiles/$(recipientId))
        || (publicProfile(recipientId).privacy.visibility == 'public'
            && publicProfile(recipientId).privacy.get('allowMessages', true) == true);
    }

    // Same "missing profile doc = allowed" reasoning as commentsAllowed.
    // Same missing-key reasoning as messagesAllowed above.
    function callsAllowed(calleeId) {
      return !exists(/databases/$(database)/documents/profiles/$(calleeId))
        || (publicProfile(calleeId).privacy.visibility == 'public'
            && publicProfile(calleeId).privacy.get('allowCalls', true) == true);
    }

    // Public profile fields — anonymous income/savings and the
    // owner's own block list live in subcollections below, never here.
    match /profiles/{uid} {
      allow read: if true;
      // A brand-new profile always starts at 0 coins/0 XP — `UserProfile`'s
      // own constructor defaults, never overridden by `ProfileService`/
      // the wizard's create flow (the first real grant, `profileCompleted`,
      // is a separate subsequent update, not part of creation) — so a
      // create claiming otherwise is definitely not the real app.
      allow create: if isOwner(uid)
        && request.resource.data.get('coins', 0) == 0
        && request.resource.data.get('xp', 0) == 0
        && validScoreBounds(request.resource.data.score);
      allow delete: if isOwner(uid);
      // The owner can change anything, subject to `ownerProfileUpdateIsSafe`
      // (see above — bounds a single write's coins/XP increase to the
      // largest real single-grant amount, and keeps `score` within the
      // 0-100 range the real scoring engine always produces). Any other
      // signed-in user may touch only `ratingSummary` (the running
      // aggregate a rater's device updates transactionally when it
      // submits/edits/removes its own rating), `viewCount` (incremented
      // by a viewer's device each time it opens this profile),
      // `photoVoteCounts` (the same transactional-aggregate pattern, for
      // best-photo votes), or `nukeDamage`/`nukesSurvived`/`score`
      // together (a nuke attacker's device applying
      // `NukeService.damagePerNuke` to one Life Score attribute — see
      // `RemoteNukeRepository.attack`), now bounded to a single real
      // nuke's worth of damage rather than an arbitrary score value.
      // Like the `ratingSummary`/`viewCount`/`photoVoteCounts`
      // aggregates, the exact delta arithmetic still isn't fully
      // re-derived here — the app trusts its own client logic for that,
      // same disclosed posture as every other transactional aggregate on
      // this document; `request.auth.uid != uid` just keeps the owner's
      // own edits on the unrestricted (but now bounded) branch above.
      allow update: if (isOwner(uid) && ownerProfileUpdateIsSafe())
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSummary']))
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']))
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoVoteCounts']))
        || (isSignedIn() && request.auth.uid != uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nukeDamage', 'nukesSurvived', 'score'])
            && request.resource.data.nukesSurvived == resource.data.get('nukesSurvived', 0) + 1
            && request.resource.data.nukeDamage.diff(resource.data.get('nukeDamage', {})).affectedKeys().size() == 1
            && validScoreBounds(request.resource.data.score)
            && request.resource.data.score.overall <= resource.data.score.get('overall', 100)
            && request.resource.data.score.overall >= resource.data.score.get('overall', 100) - 2);

      match /private/income {
        allow read: if isOwner(uid) || publicProfile(uid).privacy.showIncome == true;
        allow write: if isOwner(uid);
      }

      match /private/savings {
        allow read: if isOwner(uid) || publicProfile(uid).privacy.showSavings == true;
        allow write: if isOwner(uid);
      }

      // investments/debt/monthlyExpenses feed the owner's own Life
      // Score calculation only — the app never displays them to
      // anyone, including the owner, on any screen today.
      match /private/financeExtra {
        allow read, write: if isOwner(uid);
      }

      // Never readable by anyone but the blocker — a blocked user must
      // never learn they were blocked.
      match /blocked/{blockedId} {
        allow read, write: if isOwner(uid);
      }
    }

    // One rating per (rater, profile), doc id "{raterId}_{profileId}".
    // Only the rater can ever read their own rating record — nobody,
    // not even the profile owner, can learn who rated them or see an
    // individual score. Public visibility is the aggregate written to
    // `profiles/{profileId}.ratingSummary` above, never this document.
    match /ratings/{ratingId} {
      // `resource == null` covers reading a rating that doesn't exist
      // yet — an upsert transaction checks for a prior rating before
      // writing, and without this guard Firestore denies that
      // existence check outright instead of returning "not found".
      allow read: if isSignedIn() && (resource == null || resource.data.raterId == request.auth.uid);
      allow update, delete: if isSignedIn() && resource.data.raterId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.raterId == request.auth.uid
        && request.resource.data.profileId != request.auth.uid
        && ratingId == request.auth.uid + '_' + request.resource.data.profileId;
    }

    // One "best photo" vote per (voter, profile), same shape and
    // anonymity as `ratings` above — only the voter can ever read
    // their own vote; the public signal is the aggregate written to
    // `profiles/{profileId}.photoVoteCounts`, never this document.
    match /photoVotes/{voteId} {
      allow read: if isSignedIn() && resource.data.voterId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.voterId == request.auth.uid
        && request.resource.data.profileId != request.auth.uid
        && voteId == request.auth.uid + '_' + request.resource.data.profileId;
      allow update: if isSignedIn() && resource.data.voterId == request.auth.uid;
      allow delete: if false;
    }

    // One doc per nuke attack. Only the attacker can ever read it — the
    // target never learns who attacked them, only that its own
    // `nukeDamage`/`nukesSurvived`/`score` changed (see the `profiles`
    // update rule above). Immutable once created, like `battleVotes`.
    match /nukeEvents/{eventId} {
      allow read: if isSignedIn() && resource.data.attackerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.attackerId == request.auth.uid
        && request.resource.data.targetId != request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // Unlike ratings, comment authorship is meant to be visible (the
    // app already shows commenters' names) — so comments are just
    // normal public content, not anonymity-protected like ratings.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.profileOwnerId != request.auth.uid
        && commentsAllowed(request.resource.data.profileOwnerId)
        && !hasBlocked(request.auth.uid, request.resource.data.profileOwnerId)
        && !hasBlocked(request.resource.data.profileOwnerId, request.auth.uid);
      // The author can change anything about their own comment; the
      // profile owner may only blank+mark it deleted (never rewrite someone
      // else's words), matching `CommentService.deleteComment` exactly.
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid
        || (resource.data.profileOwnerId == request.auth.uid
            && request.resource.data.content == ''
            && request.resource.data.isDeleted == true)
      );
      allow delete: if false;
    }

    match /commentReactions/{reactionId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // Private direct messages — readable only by the two participants,
    // never the whole collection (unlike comments, which are public).
    match /messages/{messageId} {
      // Must check `participants` specifically (not senderId/recipientId,
      // even though they're logically equivalent) — RemoteMessageRepository
      // queries `where('participants', arrayContains: uid)`, and Firestore
      // rejects a list query outright unless the rule is provably true
      // for every document the query could match, evaluated against the
      // exact field(s) the query filters on.
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && messagesAllowed(request.resource.data.recipientId)
        && !hasBlocked(request.auth.uid, request.resource.data.recipientId)
        && !hasBlocked(request.resource.data.recipientId, request.auth.uid);
      // Only the recipient can touch a message after creation, and only
      // to flip isRead — the sender's own words stay theirs to delete,
      // never to be rewritten by the other side.
      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
    }

    // 1:1 audio-call signaling. Same participants-field query-alignment
    // requirement as messages: RemoteCallRepository's `currentCall`
    // stream queries `where('participants', arrayContains: uid)`, so
    // the read rule must check `participants` directly. A call requires
    // an existing conversation (enforced client-side by `CallService`;
    // there's no cheap way to re-derive "has an existing conversation"
    // from a security rule without a second read per call attempt, so
    // this rule enforces the same allow/block/privacy checks messages
    // use and leaves the conversation-prerequisite check to the client).
    match /calls/{callId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.participants == [request.auth.uid, request.resource.data.calleeId]
        && request.resource.data.status == 'ringing'
        && callsAllowed(request.resource.data.calleeId)
        && !hasBlocked(request.auth.uid, request.resource.data.calleeId)
        && !hasBlocked(request.resource.data.calleeId, request.auth.uid);
      // Three allowed transitions, each restricted to the field(s) it
      // actually touches: the callee accepting (attaches `answer`, flips
      // to active), the callee declining, and either side ending the call.
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants && (
        (resource.data.calleeId == request.auth.uid
          && resource.data.status == 'ringing'
          && request.resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'status']))
        || (resource.data.calleeId == request.auth.uid
          && resource.data.status == 'ringing'
          && request.resource.data.status == 'declined'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (request.resource.data.status == 'ended'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );

      match /callerCandidates/{candidateId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid;
      }
      match /calleeCandidates/{candidateId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid;
      }
    }

    // A battle is a matchup one device generates purely for itself to
    // judge — the shown "audience split" is a deterministic estimate,
    // never a real tally, so there is no reason for any other user to
    // ever see or write another device's battles or votes. Immutable
    // once created: no update/delete anywhere in the app's own flows.
    match /battles/{battleId} {
      allow read: if isSignedIn() && resource.data.generatedBy == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.generatedBy == request.auth.uid;
    }

    match /battleVotes/{voteId} {
      allow read: if isSignedIn() && resource.data.voterId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.voterId == request.auth.uid;
    }

    // Unlike a battle's estimated split, "What Would You Choose" is a
    // real vote tally — the prompts are hypothetical, not tied to any
    // real profile's Life Score, so there's no formula to estimate
    // from. Own vote stays private like a rating; the shared count
    // lives in the small `choiceAggregates` doc below, same trust
    // level as `photoVoteCounts`/`ratingSummary` (any signed-in device
    // can bump it by one, never read/write another voter's own pick).
    match /choiceVotes/{voteId} {
      allow read: if isSignedIn() && resource.data.voterId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.voterId == request.auth.uid
        && voteId == request.auth.uid + '_' + request.resource.data.questionId;
      allow update: if false;
      allow delete: if false;
    }

    match /choiceAggregates/{questionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // XP/coins/achievements/daily-challenge completions are all
    // personal progression logs — never read by anyone but the device
    // that earned them, and (like battles) append-only: nothing here
    // is ever edited or removed by the app's own flows. `amount` is
    // validated against `validXpAmount` above — without this, a signed-in
    // device could write a doc with an arbitrary amount directly and
    // inflate its own XP total without limit (`Wallet`/`LevelInfo` are
    // summed from this collection client-side).
    match /xpTransactions/{txId} {
      allow read: if isSignedIn() && resource.data.profileId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.profileId == request.auth.uid
        && validXpAmount(request.resource.data.reason, request.resource.data.amount);
    }

    // One doc per user (doc id = uid), not a growing per-event
    // collection like the transaction logs above — an app-open day only
    // needs "did this day happen," appended via arrayUnion.
    match /appOpens/{uid} {
      allow read, write: if isOwner(uid);
    }

    // This device's push-notification token, read only by the Cloud
    // Functions in functions/index.js (the Admin SDK bypasses these
    // rules entirely — this only governs client access) to send a
    // notification when this user gets a new message or call.
    match /fcmTokens/{uid} {
      allow read, write: if isOwner(uid);
    }

    // `amount` validated against `validCoinAmount` above — same reasoning
    // as `xpTransactions`, for the coin ledger `Wallet` is summed from.
    match /coinTransactions/{txId} {
      allow read: if isSignedIn() && resource.data.profileId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.profileId == request.auth.uid
        && validCoinAmount(request.resource.data.reason, request.resource.data.amount);
    }

    match /cosmeticPurchases/{id} {
      allow read: if isSignedIn() && resource.data.profileId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.profileId == request.auth.uid;
    }

    match /userAchievements/{id} {
      allow read: if isSignedIn() && resource.data.profileId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.profileId == request.auth.uid;
    }

    match /challengeCompletions/{id} {
      allow read: if isSignedIn() && resource.data.profileId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.profileId == request.auth.uid;
    }
  }
}
