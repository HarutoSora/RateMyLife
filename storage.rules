rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos are as public as the profile itself (same tier as
    // displayName/bio — not the income/savings/rater-identity tier,
    // which stays owner-only). Only the owner can upload/replace/
    // delete their own files.
    match /profile_photos/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
